{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "outDir": "dist"
  },
  "include": ["src"]
}
